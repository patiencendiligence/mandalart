    "html2canvas": "^1.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-web": "^0.21.0",
    "react-native-widget-extension": "^0.2.0"
  },
  "devDependencies": {
