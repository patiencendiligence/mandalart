{
  "expo": {
    "name": "만다라트",
    "slug": "mandalart-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8e8e9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mandalart.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "이미지 저장을 위해 사진 라이브러리 접근이 필요합니다",
        "NSPhotoLibraryAddUsageDescription": "만다라트 이미지를 사진 앱에 저장하기 위해 접근이 필요합니다",
        "CFBundleDisplayName": "만다라트",
        "CFBundleLocalizations": [
          "ko",
          "en"
        ],
        "CFBundleDevelopmentRegion": "ko",
        "NSUserActivityTypes": [
          "ConfigurationAppIntent"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e8e8e9"
      },
      "package": "com.mandalart.app",
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "만다라트 - 목표 달성 플래너",
      "shortName": "만다라트",
      "description": "오타니 쇼헤이의 만다라트 목표 달성법으로 체계적인 목표 관리를 하세요.",
      "lang": "ko",
      "themeColor": "#e8e8e9",
      "backgroundColor": "#e8e8e9"
    },
    "plugins": [
      "expo-font",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MandalartWidget",
              "label": "만다라트",
              "description": "목표와 진행률을 한눈에 확인하세요",
              "minWidth": "300dp",
              "minHeight": "110dp",
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "targetCellWidth": 3,
              "targetCellHeight": 2
            },
            {
              "name": "MandalartWidgetSmall",
              "label": "만다라트 (소형)",
              "description": "목표와 진행률 간단히 확인",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "previewImage": "./assets/widget-preview-small.png",
              "resizeMode": "none",
              "targetCellWidth": 2,
              "targetCellHeight": 2
            }
          ]
        }
      ],
      [
        "react-native-widget-extension",
        {
          "frequentUpdates": true,
          "widgetsFolder": "ios-widgets"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "95db7a3b-fe68-41e4-99ff-7ca6e581ee06"
      }
    },
    "owner": "frontendmj"
  }
}
